# 策略 #4 — 期现套利 (Phase 0 主力, D.1.5)
# 对应文档: docs/04_strategy_spot_perp.md
#
# 交易模式切换（通过服务器 .env 控制，不改此文件）:
#   TRADING_MODE=paper  → PaperBroker 模拟成交（默认）
#   TRADING_MODE=live   → LiveBroker 真实下单（仅 premium 方向，D.1）
#
# D.1.5 阈值校准（2026-05-09）:
#   round-trip 手续费 ≈ 0.16% (4 legs × 0.04%)
#   入场 0.30% 留 0.10% 缓冲 + 0.04% 利润空间
#   收敛 0.03% 让大部分 premium 入场后 1-3 tick 内可平
#
# D.2 待开放: discount 方向（需 Binance spot margin）+ 真实成交价 PnL

instance_name: spot_perp_main
strategy_type: spot_perp
enabled: true

entry:
  min_basis_pct: 0.40           # W1 0.30→0.40：maker fee 0.08% + slippage 0.04% + profit 0.28%
  # c — 方向独立阈值（>0 时覆盖 min_basis_pct；0 或省略则回退）
  # discount 方向有 borrow 利息 + 付 funding 双层成本，必须 ≥ premium 阈值 + 0.20%
  min_basis_pct_premium: 0.40   # W1 同步上调
  min_basis_pct_discount: 0.80  # W1 同步上调（保持 +0.40% 利差覆盖 borrow+funding）
  scan_threshold_pct: 0.10      # scanner 候选门槛（API 暴露所有 ≥0.10% 的机会，不一定开仓）
  min_orderbook_depth_usd: 20000  # P2-19 long-tail spot 深度 cushion（5K→20K 防滑点放大）
  # b — 入场时机过滤（防接飞刀）：要求 |basis| 已从近 N 分钟峰值回落 ≥ M%
  # 例：peak_window=10min, dropoff=0.05% → |basis| 必须先到过 0.35% 然后回落到 0.30% 才开（entry=0.30%）
  # 0 = 禁用（旧行为：见到阈值即入场）
  peak_window_minutes: 10       # 滑窗时长（分钟）
  min_peak_dropoff_pct: 0.05    # 最少回落幅度（pct）

exit:
  basis_convergence_pct: 0.10   # 收敛平仓阈值（D.2.b 实战调优 0.03→0.10 防噪音）
  # P1-8 R:R 平衡：entry 0.30% → exit 0.10%（profit 0.20%）→ stop 0.20%（R:R = 1:1）
  # 旧 0.50% 单笔最大亏 -0.66%，对称化后 -0.20% 损失对称 +0.20% 盈利
  stop_basis_widening_pct: 0.20
  max_hold_hours: 6.0           # P2-18 12h→6h：basis 大多 5-30min 内收敛；12h 持仓多在等 max_hold 触发
  min_hold_minutes: 5.0         # 最短持仓（防 1-3min 内 scanner 抖动触发噪音平仓）

position:
  max_positions: 3              # 同时持仓上限（含 paper 试样）
  size_usd: 50.0                # D.1 实盘 notional（也可被 .env SPOT_PERP_NOTIONAL_USD 覆盖）
  exchanges: ["binance", "okx"] # 双交易所并行扫描
  direction_filter: "premium"   # D.1 仅 premium；D.2 改为 "both" 并接 spot margin
  candidate_symbols:            # 30 主流 USDT 永续候选币（市值 / 流动性靠前）
    - BTC
    - ETH
    - SOL
    - BNB
    - XRP
    - DOGE
    - TRX
    - ADA
    - AVAX
    - LINK
    - DOT
    - NEAR
    - BCH
    - LTC
    - UNI
    - APT
    - ARB
    - OP
    - SUI
    - ATOM
    - FIL
    - ETC
    - AAVE
    - INJ
    - ICP
    - XLM
    - RUNE
    - SEI
    - LDO
    - TIA

scanning:
  scan_interval_seconds: 30     # P2-18 60→30s：basis 收敛快，30s tick 与 #02 一致

execution:
  fee_rate: 0.0004              # 单边 taker 费率
  slippage_bps: 2

leverage:
  default: 3.0                  # 永续 isolated 杠杆
