# ===================================================================
# Dracula-System 环境变量模板
#
# 用法:
#   cp .env.example .env
#   填入真实值
#   .env 永远不会被 commit(已在 .gitignore)
# ===================================================================

# ----- 系统 -----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ----- 数据库 -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dracula
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=dracula
REDIS_URL=redis://localhost:6379/0

# ----- API 鉴权 -----
API_SECRET_KEY=CHANGE_ME
API_TOKEN=CHANGE_ME

# ===================================================================
# 交易所 API(CEX)
# 提示:申请 key 时只勾"读 + 交易",绝对不勾"提币"
# ===================================================================

BINANCE_API_KEY=
BINANCE_API_SECRET=

BYBIT_API_KEY=
BYBIT_API_SECRET=

OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

HTX_API_KEY=
HTX_API_SECRET=

BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# ===================================================================
# DEX 钱包
# ⚠️ 用专门的"交易钱包",只放当前要用的资金,大头留在硬件钱包
# ===================================================================

TRADING_WALLET_PRIVATE_KEY=
TRADING_WALLET_ADDRESS=

# RPC 节点(推荐 Alchemy / Infura,不要用公共节点)
ETH_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
BSC_RPC_URL=

# 防 MEV
FLASHBOTS_PROTECT_RPC=https://rpc.flashbots.net

# ===================================================================
# 通知
# ===================================================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DISCORD_WEBHOOK_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TO_EMAIL=
